# Server-side only. Used by next.config.ts rewrites to reach the backend.
# The browser never sees this value (same-origin topology).
API_URL=http://localhost:5001

# Client-side public env vars (baked at build time).
# NEXT_PUBLIC_API_URL is intentionally REMOVED from client use (FE-01): the app now
# talks to its own origin /api/v1/* and Next.js proxies server-side.

# ── T09 security layer ──────────────────────────────────────────────────────
# Session verification in middleware (src/middleware.ts). MUST hold the same
# value the backend signs access tokens with (c0c-bake JWT_SECRET). Without it
# the middleware fails closed — every protected route redirects to /login.
# Server-side only; never NEXT_PUBLIC, never logged.
JWT_SECRET=change-me-to-the-backend-jwt-secret

# Rollout escape hatch for the middleware gate. verify (default) | presence | off
# presence = pre-T09 cookie-presence check; off = no gate. Change + restart only.
AUTH_MIDDLEWARE_MODE=verify

# CSP rollout switch: unset = Content-Security-Policy-Report-Only (default),
# "true" = enforcing Content-Security-Policy. Change + restart only, no rebuild.
# CSP_ENFORCE=true
